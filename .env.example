# Copy to .env and fill in. Never commit .env.
# Every key is declared in library/config/src/config.schema.ts.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/summarise
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Neon Object Storage. Filled in by `neon deploy` (or `neon env pull`)
# for the linked branch; see neon.ts.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Speech-to-text: https://console.groq.com/keys
GROQ_API_KEY=

# Optional, defaults shown
# NODE_ENV=development
# PORT=3000
# WEB_ORIGIN=http://localhost:5173
# UPLOADS_BUCKET=uploads
# VITE_API_URL=http://localhost:3000
