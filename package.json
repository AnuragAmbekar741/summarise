{
  "name": "summarise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter './apps/*' dev",
